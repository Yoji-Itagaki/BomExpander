<Project Sdk="Microsoft.NET.Sdk">

  <!-- 画面（Windowsフォーム）。処理は BomTool.Core のクラスを呼び出すだけにしています。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BomTool.App</RootNamespace>
    <AssemblyName>BomTool</AssemblyName>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>BomTool.App.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>多段階BOM展開ツール</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BomTool.Core\BomTool.Core.vbproj" />
  </ItemGroup>

</Project>
